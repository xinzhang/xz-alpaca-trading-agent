# --- Alpaca paper trading (reused from btc-regime-bot's paper account) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_DATA_FEED=IEX

# --- OpenAI: decision reasoning + embeddings ---
OPENAI_API_KEY=
OPENAI_DECISION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Pinecone: news vector store ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=alphadesk-news
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Tavily: news search ---
TAVILY_API_KEY=

# --- Postgres / TimescaleDB ---
# Host port 5432 may already be taken by another local project's Postgres — this compose
# file maps the container's 5432 to host 5433 to avoid clashing with it.
DATABASE_URL=postgresql+asyncpg://alphadesk:alphadesk@localhost:5433/alphadesk

# --- Redis: pub/sub for the live dashboard ---
REDIS_URL=redis://localhost:6379/0

# --- Strategy config ---
TICKERS=AAPL,NVDA,TSLA,MSFT,AMZN
CYCLE_INTERVAL_MINUTES=15
MAX_POSITION_PCT=0.15
MAX_TOTAL_EXPOSURE_PCT=0.60
MAX_DRAWDOWN_PCT=0.10

# --- Safety ---
DRY_RUN=true

# --- Server ---
PORT=8002
